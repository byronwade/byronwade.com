{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["app/**/*.{ts,tsx}"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": ["@biomejs/biome", "postcss-load-config", "sharp"],
  "ignoreBinaries": ["docker-compose"],
  "tags": ["-public"]
}
