{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["app/**/*.{ts,tsx}", "next.config.js", "postcss.config.mjs"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}"
  ],
  "ignore": ["**/node_modules/**", ".next/**"],
  "ignoreDependencies": [
    "@biomejs/biome",
    "highlight.js",
    "postcss-load-config",
    "sharp",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreBinaries": ["docker-compose"],
  "tags": ["-public"]
}
