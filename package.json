{
  "name": "byronwade.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit:deploy": "npx --yes vercel@latest build",
    "audit:react": "npx --yes react-doctor@latest .",
    "audit:ui": "npx --yes shadcn@latest info",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:production": "NODE_ENV=production next build",
    "check": "ultracite check && npm run type-check && npm run knip",
    "clear": "rimraf .turbo .next node_modules && echo Cleared successfully",
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "docker:down": "docker-compose down",
    "docker:up": "docker-compose up --build",
    "format": "ultracite fix",
    "knip": "knip",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "perf:budget": "next build && lighthouse http://localhost:3000 --budget-path=./lighthouse-budget.json",
    "perf:lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
    "start": "next start",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@next/bundle-analyzer": "^16.2.7",
    "@phosphor-icons/react": "^2.1.10",
    "@sparticuz/chromium": "^143.0.0",
    "@vercel/analytics": "^1.4.0",
    "@vercel/speed-insights": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "figma-js": "^1.16.1-0",
    "framer-motion": "^11.18.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.5",
    "puppeteer-core": "^24.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "^4.6.0",
    "schema-dts": "^1.1.5",
    "sharp": "^0.34.2",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "knip": "^5.0.0",
    "lighthouse": "^12.6.1",
    "postcss": "^8.5.23",
    "react-scan": "^0.5.7",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "ultracite": "7.10.1"
  }
}
