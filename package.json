{
	"name": "byronwade.com",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"dev:turbo": "next dev --turbopack",
		"build": "next build",
		"build:analyze": "ANALYZE=true next build",
		"build:production": "NODE_ENV=production next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check --write . && tsc --noEmit",
		"type-check": "tsc --noEmit",
		"knip": "knip",
		"clear": "rimraf .turbo .next node_modules && echo Cleared successfully",
		"perf:lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
		"perf:budget": "next build && lighthouse http://localhost:3000 --budget-path=./lighthouse-budget.json",
		"docker:local": "docker-compose -f docker-compose.local.yml up --build",
		"docker:local:down": "docker-compose -f docker-compose.local.yml down",
		"docker:production": "docker-compose up --build",
		"docker:production:down": "docker-compose down"
	},
