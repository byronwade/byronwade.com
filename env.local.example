# Local Development Environment for local.byronwade.com
# Copy this file to .env.local and update with your actual values

NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Local Development Server
PORT=3001
HOSTNAME=local.byronwade.com

# Database Configuration (if using local database)
DATABASE_URL=postgresql://local_user:local_password@localhost:5432/local_byronwade

# Redis Configuration (if using local Redis)
REDIS_URL=redis://localhost:6379

# API Keys (replace with your actual keys for local development)
GITHUB_API_TOKEN=your_github_token_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Local Development Features
NEXT_DEBUG=true
NEXT_OPTIMIZE_FONTS=false
NEXT_OPTIMIZE_IMAGES=false

# Local Business Directory Specific
LOCAL_API_KEY=your_local_api_key_here
MAPS_API_KEY=your_maps_api_key_here
GEOCODING_API_KEY=your_geocoding_api_key_here

# Development Flags
ENABLE_LOCAL_FEATURES=true
ENABLE_DEBUG_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=false
